{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    // Workers runtime + binding types come from worker-configuration.d.ts (`wrangler types`)
    "types": []
  },
  "include": ["src", "worker-configuration.d.ts"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}

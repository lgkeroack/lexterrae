# Used by the Node.js database scripts (pnpm db:migrate, pnpm db:seed). The Worker reads
# DATABASE_URL from .dev.vars locally and from a Wrangler secret in production.

# Local Postgres behind the Neon proxy from docker-compose.yml:
DATABASE_URL=postgresql://postgres:postgres@db.localtest.me:5432/lexterrae
NEON_LOCAL_PROXY=localhost:4444

# Neon (remove NEON_LOCAL_PROXY): use the *direct* (non-pooler) connection string for migrations.
# DATABASE_URL=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require

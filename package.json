{
  "name": "lex-terrae",
  "private": true,
  "version": "0.1.0",
  "description": "Canadian jurisdiction document management — Cloudflare Workers + Neon",
  "scripts": {
    "dev": "pnpm --parallel --filter @lexterrae/web --filter @lexterrae/api dev",
    "build": "pnpm --filter @lexterrae/web build && pnpm --filter @lexterrae/api build",
    "deploy": "pnpm --filter @lexterrae/web build && pnpm --filter @lexterrae/api run deploy",
    "db:migrate": "pnpm --filter @lexterrae/api db:migrate",
    "db:seed": "pnpm --filter @lexterrae/api db:seed",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yml}\""
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  }
}
